{
  "name": "@kickbacks/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "kickbacks": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --platform node --target node20 --out-dir dist",
    "run": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
